{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Static assets-only Worker: Astro builds to ./dist and Cloudflare serves it
  // from the edge. No Worker script runs on requests.
  "name": "burakuren-com",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "burakuren.com", "custom_domain": true }],
  // Serve only from the custom domain so search engines never see a
  // duplicate copy of the site on *.workers.dev.
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true }
}
