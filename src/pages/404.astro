---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found | Burak Üren" description="This page doesn't exist." noindex>
  <main id="main" class="wrap" tabindex="-1">
    <section class="not-found" aria-labelledby="nf-title">
      <p class="not-found-code mono" aria-hidden="true">404</p>
      <h1 id="nf-title">Page not found</h1>
      <p>The page you were looking for has moved, or never existed.</p>
      <div class="cta-row">
        <a class="btn btn-primary" href="/">Home</a>
        <a class="btn" href="/blog/">Blog</a>
      </div>
    </section>
  </main>
</Base>
