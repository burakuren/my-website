---
import { getCollection, getEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Avatar from '../components/Avatar.astro';
import GuestCard from '../components/GuestCard.astro';
import Icon from '../components/Icon.astro';
import SectionTitle from '../components/SectionTitle.astro';
import photo from '../assets/burak.jpg';
import { getPosts, isExternal, postUrl } from '../lib/posts';
import { dateLabel, monthLabel } from '../lib/format';
import { bold } from '../lib/inline';
import { displayEmail, socialIcon } from '../lib/social';
import { CV_FILENAME, SITE_URL } from '../site.config.mjs';

const profile = (await getEntry('profile', 'profile'))!.data;
const skills = (await getEntry('skills', 'skills'))!.data;
const experience = (await getCollection('experience')).sort((a, b) => a.data.order - b.data.order).map((e) => e.data);
const posts = (await getPosts()).slice(0, 3);

// Square JPEG of the photo for structured data (search engines want a stable, crawlable URL).
const photoLd = await getImage({ src: photo, width: 400, height: 400, format: 'jpg', quality: 85 });
const socialLinks = profile.social.flatMap((s) => {
  const icon = socialIcon(s.key);
  return icon ? [{ ...s, icon }] : [];
});

const person = {
  '@type': 'Person',
  '@id': `${SITE_URL}/#person`,
  name: profile.name,
  alternateName: 'Burak Uren',
  url: `${SITE_URL}/`,
  image: new URL(photoLd.src, SITE_URL).href,
  jobTitle: profile.role,
  description: profile.seoDescription,
  address: { '@type': 'PostalAddress', addressLocality: profile.location.city, addressCountry: profile.location.country },
  sameAs: profile.social.map((s) => s.url),
  knowsAbout: profile.knowsAbout,
  knowsLanguage: ['tr', 'en'],
  ...(profile.alumniOf ? { alumniOf: { '@type': 'CollegeOrUniversity', name: profile.alumniOf } } : {}),
};

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ProfilePage',
    '@id': `${SITE_URL}/#profilepage`,
    url: `${SITE_URL}/`,
    name: profile.seoTitle,
    inLanguage: 'en',
    mainEntity: person,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE_URL}/#website`,
    url: `${SITE_URL}/`,
    name: profile.name,
    inLanguage: 'en',
    publisher: { '@id': `${SITE_URL}/#person` },
  },
];
---

<Base title={profile.seoTitle} description={profile.seoDescription} section="home" ogType="profile" jsonLd={jsonLd}>
  <main id="main" tabindex="-1">
    <section class="hero wrap" id="top" aria-labelledby="hero-title">
      <div class="hero-top">
        <h1 id="hero-title">
          <span class="h1-name">{profile.name}</span>
          <span class="h1-role">{profile.role}</span>
        </h1>
        <Avatar
          class="hero-photo"
          size={300}
          widths={[120, 152, 240, 300, 304, 600]}
          sizes="(min-width: 1080px) 300px, (min-width: 761px) 152px, 120px"
          alt={`Photo of ${profile.name}`}
          eager
        />
        <p class="tagline">{profile.tagline}</p>
        <p class="lead" set:html={bold(profile.lead)} />
        <div class="cta-row">
          <a class="btn btn-primary" href="#contact" data-mailto>Email me</a>
          {
            profile.resume && (
              <a class="btn" href={profile.resume} download={CV_FILENAME}>
                Download CV
                <Icon name="i-download" />
              </a>
            )
          }
          {
            profile.availability && (
              <p class="availability">
                <span class="pulse" aria-hidden="true" />
                {profile.availability}
              </p>
            )
          }
        </div>
      </div>
    </section>

    {
      profile.services.length > 0 && (
        <section class="section wrap" id="services" aria-labelledby="services-title">
          <header class="section-head">
            <SectionTitle id="services" title="How I can help" />
          </header>
          <ul class="services" role="list">
            {profile.services.map((s) => (
              <li class="service">
                <p class="service-flag mono" aria-hidden="true">
                  {s.flag}
                </p>
                <h3>{s.title}</h3>
                <p>{s.body}</p>
                {s.proof && (
                  <p class="proof">
                    <span class="proof-label">For example</span>
                    <Fragment set:html={bold(s.proof)} />
                  </p>
                )}
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="section wrap" id="experience" aria-labelledby="experience-title">
      <header class="section-head">
        <SectionTitle id="experience" title="Experience" />
      </header>
      <ol class="timeline" role="list">
        {
          experience.map((job) => (
            <li class:list={['job', { 'is-head': job.ref === 'HEAD' }]}>
              <div class="job-when">
                <span class="job-dot" aria-hidden="true" />
                <p class="job-dates">
                  <time datetime={job.start}>{monthLabel(job.start)}</time> to {job.end ? <time datetime={job.end}>{monthLabel(job.end)}</time> : 'now'}
                </p>
                {job.ref && (
                  <p class="job-ref mono" aria-hidden="true">
                    {job.ref}
                  </p>
                )}
              </div>
              <article class="job-body">
                <header class="job-head">
                  <h3>
                    {job.url ? (
                      <a href={job.url} rel="noopener">
                        {job.org}
                      </a>
                    ) : (
                      job.org
                    )}
                  </h3>
                  <p class="job-role">{job.role}</p>
                </header>
                <p class="job-summary">{job.summary}</p>
                {job.results.length > 0 && (
                  <ul class="results" role="list">
                    {job.results.map((r) => (
                      <li>
                        <strong>{r.value}</strong> {r.label}
                      </li>
                    ))}
                  </ul>
                )}
                {(job.highlights.length > 0 || job.stack.length > 0) && (
                  <details class="under-hood">
                    <summary>Technical details</summary>
                    <div class="hood-body">
                      {job.highlights.length > 0 && (
                        <ul role="list">
                          {job.highlights.map((h) => (
                            <li set:html={bold(h, 'b')} />
                          ))}
                        </ul>
                      )}
                      {job.stack.length > 0 && (
                        <ul class="stack" role="list">
                          {job.stack.map((t) => (
                            <li>{t}</li>
                          ))}
                        </ul>
                      )}
                    </div>
                  </details>
                )}
              </article>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="section wrap" id="about" aria-labelledby="about-title">
      <header class="section-head">
        <SectionTitle id="about" title="About me" />
      </header>
      <div class="about">
        <div class="about-text">
          {profile.about.map((p) => <p>{p}</p>)}
        </div>
        {
          profile.facts.length > 0 && (
            <dl class="facts">
              {profile.facts.map((f) => (
                <div>
                  <dt>{f.label}</dt>
                  <dd>
                    <Fragment set:html={bold(f.value)} />
                    {f.sub && <span class="dd-sub">{f.sub}</span>}
                  </dd>
                </div>
              ))}
            </dl>
          )
        }
      </div>
    </section>

    <section class="section wrap" id="skills" aria-labelledby="skills-title">
      <header class="section-head">
        <SectionTitle id="skills" title="Skills and tools" />
      </header>
      <div class="skills" role="table" aria-label="Skills">
        {
          skills.groups.map((g) => (
            <div class="skills-row" role="row">
              <span class="sk-area" role="rowheader">
                {g.name}
              </span>
              <span class="sk-tools" role="cell">
                {g.tools}
              </span>
            </div>
          ))
        }
      </div>
    </section>

    {
      posts.length > 0 && (
        <section class="section wrap" id="blog" aria-labelledby="blog-title">
          <header class="section-head">
            <SectionTitle id="blog" title="Blog" />
          </header>
          <ul class="posts" role="list">
            {posts.map((p) => (
              <li class:list={['post', { 'is-external': isExternal(p) }]}>
                <p class="post-date">
                  <time datetime={p.data.pubDate.toISOString()}>{dateLabel(p.data.pubDate)}</time>
                </p>
                {isExternal(p) ? (
                  <GuestCard post={p} />
                ) : (
                  <div>
                    <h3>
                      <a href={postUrl(p)}>{p.data.title}</a>
                    </h3>
                    <p>{p.data.description}</p>
                    <div class="post-row-meta">
                      {p.data.tags.map((t) => (
                        <span class="tag">{t}</span>
                      ))}
                      {p.data.draft && <span class="badge-draft">Draft</span>}
                    </div>
                  </div>
                )}
              </li>
            ))}
          </ul>
          <p class="more-link">
            <a href="/blog/">All posts</a>
          </p>
        </section>
      )
    }

    <section class="section wrap" id="contact" aria-labelledby="contact-title">
      <div class="contact">
        <div class="contact-main">
          <div class="contact-title">
            <SectionTitle id="contact" title={profile.contactHeading} />
          </div>
          {profile.contactText && <p>{profile.contactText}</p>}
          <div class="email-row">
            <a class="email-link" href="#contact" data-mailto>{displayEmail(profile.email)}</a>
            <button type="button" class="btn btn-sm copy-btn" hidden>Copy address</button>
            <span class="copy-status" role="status" aria-live="polite"></span>
          </div>
          <ul class="link-row" role="list">
            {
              socialLinks.map((s) => (
                <li>
                  <a href={s.url} rel="me noopener">
                    <Icon name={s.icon} />
                    {s.label}
                  </a>
                </li>
              ))
            }
            {
              profile.resume && (
                <li>
                  <a href={profile.resume} download={CV_FILENAME}>
                    <Icon name="i-download" />
                    Download CV
                  </a>
                </li>
              )
            }
          </ul>
        </div>
        {
          profile.contactSteps.length > 0 && (
            <div class="contact-steps">
              <h3>What happens next</h3>
              <ol role="list">
                {profile.contactSteps.map((step, i) => (
                  <li>
                    <span class="step-n" aria-hidden="true">
                      {i + 1}
                    </span>
                    <p set:html={bold(step)} />
                  </li>
                ))}
              </ol>
            </div>
          )
        }
      </div>
    </section>
  </main>
</Base>

<script>
  import '../lib/section-links';
</script>
