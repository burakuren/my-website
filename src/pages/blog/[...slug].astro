---
import type { GetStaticPaths } from 'astro';
import { getEntry, render } from 'astro:content';
import { getImage, Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Avatar from '../../components/Avatar.astro';
import { getPosts, localPosts, postUrl, type Post } from '../../lib/posts';
import Icon from '../../components/Icon.astro';
import { dateLabel, readingMinutes } from '../../lib/format';
import { socialIcon } from '../../lib/social';
import { SITE_URL } from '../../site.config.mjs';

export const getStaticPaths = (async () => {
  // Guest posts live elsewhere and get no page. Posts are sorted newest
  // first: the "older" post is the next one in the list.
  const posts = localPosts(await getPosts());
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, older: posts[i + 1], newer: posts[i - 1] },
  }));
}) satisfies GetStaticPaths;

interface Props {
  post: Post;
  older?: Post;
  newer?: Post;
}

const { post, older, newer } = Astro.props;
const { Content, headings } = await render(post);
const profile = (await getEntry('profile', 'profile'))!.data;
const { title, description, pubDate, updatedDate, tags, cover, coverAlt } = post.data;

const toc = headings.filter((h) => h.depth === 2);
const minutes = readingMinutes(post.body ?? '');
const modified = updatedDate ?? pubDate;
const url = `${SITE_URL}${postUrl(post)}`;
const socialLinks = profile.social.flatMap((s) => {
  const icon = socialIcon(s.key);
  return icon ? [{ ...s, icon }] : [];
});

const og = cover ? await getImage({ src: cover, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 82 }) : undefined;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    '@id': `${url}#post`,
    mainEntityOfPage: { '@type': 'WebPage', '@id': url },
    url,
    headline: title,
    description,
    datePublished: pubDate.toISOString(),
    dateModified: modified.toISOString(),
    inLanguage: 'en',
    keywords: tags.join(', '),
    wordCount: (post.body ?? '').split(/\s+/).filter(Boolean).length,
    image: og ? new URL(og.src, SITE_URL).href : `${SITE_URL}/og.png`,
    author: { '@type': 'Person', '@id': `${SITE_URL}/#person`, name: profile.name, url: `${SITE_URL}/` },
    publisher: { '@type': 'Person', '@id': `${SITE_URL}/#person`, name: profile.name, url: `${SITE_URL}/` },
    isPartOf: { '@type': 'Blog', '@id': `${SITE_URL}/blog/#blog` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE_URL}/blog/` },
      { '@type': 'ListItem', position: 3, name: title, item: url },
    ],
  },
];
---

<Base
  title={`${title} | ${profile.name}`}
  description={description}
  section="blog"
  ogType="article"
  ogImage={og?.src}
  ogImageAlt={cover ? (coverAlt ?? title) : undefined}
  article={{ published: pubDate, modified: updatedDate, tags }}
  noindex={post.data.draft}
  jsonLd={jsonLd}
>
  <main id="main" class="wrap post-grid" tabindex="-1">
    <nav class="crumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        <li><a href="/blog/">Blog</a></li>
        <li><span aria-current="page">{title}</span></li>
      </ol>
    </nav>

    <header class="post-header">
      <div class="post-meta">
        <time datetime={pubDate.toISOString()}>{dateLabel(pubDate)}</time>
        <span><strong>{minutes}</strong> min read</span>
        {
          tags.length > 0 && (
            <span class="tags">
              {tags.map((t) => (
                <a class="tag" href={`/blog/?tag=${encodeURIComponent(t)}`}>
                  {t}
                </a>
              ))}
            </span>
          )
        }
        {post.data.draft && <span class="badge-draft">Draft</span>}
      </div>
      <h1 id="post-title">{title}</h1>
      <p class="dek">{description}</p>
      {
        cover && (
          <figure class="post-cover">
            <Image src={cover} alt={coverAlt ?? ''} widths={[720, 1120, 1440]} sizes="(min-width: 800px) 720px, calc(100vw - 32px)" loading="eager" fetchpriority="high" />
          </figure>
        )
      }
    </header>

    {
      toc.length > 1 && (
        <details class="toc" open>
          <summary>On this page</summary>
          <ol>
            {toc.map((h) => (
              <li>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ol>
        </details>
      )
    }

    <article class="post-body" aria-labelledby="post-title">
      <div class="prose">
        <Content />
      </div>

      <div class="post-foot">
        <span>Last updated <time datetime={modified.toISOString()}>{dateLabel(modified)}</time></span>
        <a href="/#contact" data-mailto data-subject={`Re: ${title}`}>Found a mistake? Email me</a>
      </div>

      <section class="author" aria-label="About the author">
        <Avatar size={96} alt="" />
        <div>
          <p class="author-name">{profile.name}</p>
          <p class="author-role">{profile.role}</p>
          <p class="author-bio">I write about things I've built, broken and fixed: APIs, infrastructure and Linux.</p>
          <ul class="link-row" role="list">
            {
              socialLinks.map((s) => (
                <li>
                  <a href={s.url} rel="me noopener">
                    <Icon name={s.icon} />
                    {s.label}
                  </a>
                </li>
              ))
            }
            <li>
              <a href="/rss.xml"><Icon name="si-rss" />RSS</a>
            </li>
            <li>
              <a href="/#about"><Icon name="i-user" />About me</a>
            </li>
          </ul>
        </div>
      </section>

      <nav class="pager" aria-label="More posts">
        {
          older ? (
            <a href={postUrl(older)} rel="prev">
              <small>Older post</small>
              <strong>{older.data.title}</strong>
            </a>
          ) : (
            <div class="none">
              <small>Older post</small>
              <strong>This is the first post.</strong>
            </div>
          )
        }
        {
          newer ? (
            <a href={postUrl(newer)} rel="next" class="next">
              <small>Newer post</small>
              <strong>{newer.data.title}</strong>
            </a>
          ) : (
            <div class="none next">
              <small>Newer post</small>
              <strong>This is the latest post.</strong>
            </div>
          )
        }
      </nav>
    </article>
  </main>
</Base>

<script>
  // Code copy buttons ship hidden (shiki-code-header.mjs); reveal and wire
  // them when the Clipboard API exists.
  if (navigator.clipboard) {
    document.querySelectorAll<HTMLButtonElement>('.code-copy').forEach((button) => {
      button.hidden = false;
      let timer: number | undefined;
      button.addEventListener('click', async () => {
        const code = button.closest('.code-block')?.querySelector('pre code')?.textContent ?? '';
        try {
          await navigator.clipboard.writeText(code);
          button.textContent = 'Copied';
          button.classList.add('is-copied');
        } catch {
          button.textContent = 'Copy failed';
        }
        clearTimeout(timer);
        timer = window.setTimeout(() => {
          button.textContent = 'Copy';
          button.classList.remove('is-copied');
        }, 1600);
      });
    });
  }

  // "On this page": an always-open sticky rail at >=1080px; below that a
  // disclosure that starts closed and closes again after a link is chosen.
  const toc = document.querySelector<HTMLDetailsElement>('.toc');
  if (toc) {
    const desktop = matchMedia('(min-width: 1080px)');
    const summary = toc.querySelector('summary')!;
    const sync = () => {
      toc.open = desktop.matches;
      summary.tabIndex = desktop.matches ? -1 : 0;
    };
    sync();
    desktop.addEventListener('change', sync);
    toc.addEventListener('toggle', () => {
      if (desktop.matches && !toc.open) toc.open = true;
    });
    toc.addEventListener('click', (e) => {
      if (!desktop.matches && (e.target as Element).closest('a')) toc.open = false;
    });

    // The current section is the last heading that has scrolled past the
    // sticky header.
    const links = [...toc.querySelectorAll<HTMLAnchorElement>('a')];
    const headings = links.map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))));
    let ticking = false;
    const markCurrent = () => {
      ticking = false;
      let current = -1;
      headings.forEach((h, i) => {
        if (h && h.getBoundingClientRect().top < 120) current = i;
      });
      links.forEach((a, i) => a.setAttribute('aria-current', String(i === current)));
    };
    addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(markCurrent);
        }
      },
      { passive: true },
    );
    markCurrent();
  }
</script>
