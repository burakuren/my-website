---
import { getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import GuestCard from '../../components/GuestCard.astro';
import Icon from '../../components/Icon.astro';
import { getPosts, isExternal, postUrl } from '../../lib/posts';
import { dateLabel, readingMinutes } from '../../lib/format';
import { SITE_URL } from '../../site.config.mjs';

const profile = (await getEntry('profile', 'profile'))!.data;
const posts = await getPosts();

const tagCounts = new Map<string, number>();
for (const p of posts) for (const t of p.data.tags) tagCounts.set(t, (tagCounts.get(t) ?? 0) + 1);
const tags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));

const groups: { year: string; posts: typeof posts }[] = [];
for (const p of posts) {
  const year = String(p.data.pubDate.getUTCFullYear());
  const last = groups.at(-1);
  if (last?.year === year) last.posts.push(p);
  else groups.push({ year, posts: [p] });
}

const title = `Blog | ${profile.name}`;
const description = 'Notes from building and running systems: backend, infrastructure and Linux. What worked, what broke, and why.';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    '@id': `${SITE_URL}/blog/#blog`,
    url: `${SITE_URL}/blog/`,
    name: title,
    description,
    inLanguage: 'en',
    author: { '@type': 'Person', '@id': `${SITE_URL}/#person`, name: profile.name, url: `${SITE_URL}/` },
    blogPost: posts
      .filter((p) => !isExternal(p))
      .map((p) => ({
        '@type': 'BlogPosting',
        headline: p.data.title,
        url: `${SITE_URL}${postUrl(p)}`,
        datePublished: p.data.pubDate.toISOString(),
      })),
  },
];
---

<Base title={title} description={description} section="blog" noindex={posts.length === 0} jsonLd={jsonLd}>
  <main id="main" class="wrap" tabindex="-1">
    <div class="page-head">
      <h1 id="blog-title">Blog</h1>
      <a class="rss-link" href="/rss.xml"><Icon name="si-rss" />RSS feed</a>
    </div>

    {
      posts.length === 0 ? (
        <div class="list-state">
          <h2>No posts yet</h2>
          <p>The first one is being written. Subscribe to the RSS feed to get it when it's published.</p>
          <a class="btn" href="/rss.xml">
            <Icon name="si-rss" />
            Subscribe via RSS
          </a>
        </div>
      ) : (
        <>
          {/* Progressive enhancement: hidden until JS runs; the full list is in the HTML. */}
          <section class="filters" aria-label="Filter posts" data-filters hidden>
            <label class="search">
              <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                <circle cx="11" cy="11" r="7" />
                <path d="m20 20-3.5-3.5" />
              </svg>
              <input type="search" placeholder="Search posts" aria-label="Search posts" autocomplete="off" spellcheck="false" data-query />
            </label>
            {tags.length > 0 && (
              <div class="tag-filter" role="group" aria-label="Filter by tag">
                <button type="button" aria-pressed="true" data-tag="all">
                  all <span class="count">{posts.length}</span>
                </button>
                {tags.map(([t, n]) => (
                  <button type="button" aria-pressed="false" data-tag={t}>
                    {t} <span class="count">{n}</span>
                  </button>
                ))}
              </div>
            )}
          </section>

          <p class="post-total" aria-live="polite" data-total>
            {posts.length === 1 ? '1 post' : `${posts.length} posts`}
          </p>

          <div data-groups>
            {groups.map((g) => (
              <section class="year-group" aria-labelledby={`y${g.year}`} data-group>
                <h2 id={`y${g.year}`}>{g.year}</h2>
                <ul class="post-list" role="list">
                  {g.posts.map((p) => (
                    <li
                      class:list={['post-row', { 'is-external': isExternal(p) }]}
                      data-post
                      data-tags={p.data.tags.join(' ')}
                      data-text={`${p.data.title} ${p.data.description} ${p.data.publisher ?? ''} ${p.data.tags.join(' ')}`.toLowerCase()}
                    >
                      <p class="post-row-date">
                        <time datetime={p.data.pubDate.toISOString()}>{dateLabel(p.data.pubDate)}</time>
                      </p>
                      {isExternal(p) ? (
                        <GuestCard post={p} />
                      ) : (
                        <div>
                          <h3>
                            <a href={postUrl(p)}>{p.data.title}</a>
                          </h3>
                          <p>{p.data.description}</p>
                          <div class="post-row-meta">
                            {p.data.tags.map((t) => (
                              <span class="tag">{t}</span>
                            ))}
                            <span class="mins">
                              <strong>{readingMinutes(p.body ?? '')}</strong> min read
                            </span>
                            {p.data.draft && <span class="badge-draft">Draft</span>}
                          </div>
                        </div>
                      )}
                    </li>
                  ))}
                </ul>
              </section>
            ))}
          </div>

          <div class="list-state" data-no-results hidden>
            <h2>
              No posts match <span data-echo />
            </h2>
            <p>Try a shorter search, or clear the filters to see every post.</p>
            <button type="button" class="btn" data-clear>
              Clear filters
            </button>
          </div>
        </>
      )
    }
  </main>
</Base>

<script>
  // Progressive enhancement: the full list is server-rendered; this only hides
  // rows. Filter state is mirrored in ?q= and ?tag=.
  const filters = document.querySelector<HTMLElement>('[data-filters]');
  if (filters) {
    filters.hidden = false;
    const input = filters.querySelector<HTMLInputElement>('[data-query]')!;
    const tagButtons = [...filters.querySelectorAll<HTMLButtonElement>('[data-tag]')];
    const items = [...document.querySelectorAll<HTMLElement>('[data-post]')];
    const groups = [...document.querySelectorAll<HTMLElement>('[data-group]')];
    const total = document.querySelector<HTMLElement>('[data-total]')!;
    const noResults = document.querySelector<HTMLElement>('[data-no-results]')!;
    const groupsWrap = document.querySelector<HTMLElement>('[data-groups]')!;
    const echo = document.querySelector<HTMLElement>('[data-echo]')!;
    let tag = 'all';

    const params = new URLSearchParams(location.search);
    if (params.get('q')) input.value = params.get('q')!;
    if (tagButtons.some((b) => b.dataset.tag === params.get('tag'))) tag = params.get('tag')!;

    function apply() {
      const q = input.value.trim().toLowerCase();
      let shown = 0;
      for (const item of items) {
        const ok = (tag === 'all' || item.dataset.tags!.split(' ').includes(tag)) && (!q || item.dataset.text!.includes(q));
        item.hidden = !ok;
        if (ok) shown++;
      }
      for (const g of groups) g.hidden = !g.querySelector('[data-post]:not([hidden])');
      tagButtons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.tag === tag)));
      total.textContent = shown === 1 ? '1 post' : `${shown} posts`;
      groupsWrap.hidden = shown === 0;
      noResults.hidden = shown !== 0;
      echo.textContent = q ? `“${q}”` : `the tag “${tag}”`;

      const url = new URL(location.href);
      q ? url.searchParams.set('q', q) : url.searchParams.delete('q');
      tag !== 'all' ? url.searchParams.set('tag', tag) : url.searchParams.delete('tag');
      history.replaceState(null, '', url);
    }

    input.addEventListener('input', apply);
    tagButtons.forEach((b) =>
      b.addEventListener('click', () => {
        tag = b.dataset.tag!;
        apply();
      }),
    );
    document.querySelector('[data-clear]')?.addEventListener('click', () => {
      input.value = '';
      tag = 'all';
      apply();
      input.focus();
    });
    apply();
  }
</script>
