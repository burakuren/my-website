---
import { getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ManLine from '../../components/ManLine.astro';
import { getPosts, postUrl } from '../../lib/posts';
import { isoDate, readingMinutes } from '../../lib/format';
import { SITE_URL } from '../../site.config.mjs';
import { categoryUrl, getCategories } from '../../lib/lab';
import '../../styles/lab.css';

const profile = (await getEntry('profile', 'profile'))!.data;
const posts = await getPosts();

const tagCounts = new Map<string, number>();
for (const p of posts) for (const t of p.data.tags) tagCounts.set(t, (tagCounts.get(t) ?? 0) + 1);
const tags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));

// Lab: categories referenced from posts, in CMS order, only those in use.
const allCategories = await getCategories();
const categories = allCategories.filter((c) => posts.some((p) => p.data.category?.id === c.id));
const catOf = (id?: string) => allCategories.find((c) => c.id === id);

const groups: { year: string; posts: typeof posts }[] = [];
for (const p of posts) {
  const year = String(p.data.pubDate.getUTCFullYear());
  const last = groups.at(-1);
  if (last?.year === year) last.posts.push(p);
  else groups.push({ year, posts: [p] });
}

const title = `Blog | ${profile.name}`;
const description = 'Notes from building and running systems: backend, infrastructure and Linux. What worked, what broke, and why.';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    '@id': `${SITE_URL}/blog/#blog`,
    url: `${SITE_URL}/blog/`,
    name: title,
    description,
    inLanguage: 'en',
    author: { '@type': 'Person', '@id': `${SITE_URL}/#person`, name: profile.name, url: `${SITE_URL}/` },
    blogPost: posts.map((p) => ({
      '@type': 'BlogPosting',
      headline: p.data.title,
      url: `${SITE_URL}${postUrl(p)}`,
      datePublished: p.data.pubDate.toISOString(),
    })),
  },
];
---

<Base title={title} description={description} section="blog" cwd="~/blog" manPage="BLOG(7)" noindex={posts.length === 0} jsonLd={jsonLd}>
  <main id="main" class="wrap" tabindex="-1">
    <ManLine page="BLOG(7)" title="Miscellaneous Information" />

    <section class="page-intro" aria-labelledby="blog-title">
      <div class="page-intro-copy">
        <p class="label" aria-hidden="true">NAME</p>
        <h1 class="page-title indent" id="blog-title">Writing</h1>
        <p class="page-lede indent">Notes from building and running systems: backend, infrastructure and Linux. What worked, what broke, and why.</p>
      </div>
      <a class="rss-link" href="/rss.xml"><span class="c-amber">rss</span><span class="muted">/rss.xml</span></a>
    </section>

    {
      posts.length > 0 && (
        <section class="filters" aria-label="Filter posts" data-filters hidden>
          <label class="search">
            <span class="c-green" aria-hidden="true">❯</span>
            <span class="muted" aria-hidden="true">grep -i</span>
            <input type="search" placeholder="search posts…" aria-label="Search posts" autocomplete="off" spellcheck="false" data-query />
          </label>
          {categories.length > 0 && (
            <div class="tag-filter" role="group" aria-label="Filter by category">
              <button type="button" aria-pressed="true" data-cat="all">--category=all</button>
              {categories.map((c) => (
                <button type="button" aria-pressed="false" data-cat={c.id} style={`--accent: ${c.data.color}`}>
                  <span class="dot" />{c.data.name} <span class="count">{posts.filter((p) => p.data.category?.id === c.id).length}</span>
                </button>
              ))}
            </div>
          )}
          {tags.length > 0 && (
            <div class="tag-filter" role="group" aria-label="Filter by tag">
              <button type="button" aria-pressed="true" data-tag="all">all <span class="count">{posts.length}</span></button>
              {tags.map(([t, n]) => (
                <button type="button" aria-pressed="false" data-tag={t}>
                  {t} <span class="count">{n}</span>
                </button>
              ))}
            </div>
          )}
        </section>
      )
    }

    <div class="post-total" aria-live="polite"><span data-total>total {posts.length}</span></div>

    {
      posts.length === 0 ? (
        <div class="empty">
          <p><span class="muted">ls:</span> no posts yet; the first one is being written.</p>
          <p class="muted">Subscribe to <a href="/rss.xml" class="c-green">rss.xml</a> to get it when it lands.</p>
        </div>
      ) : (
        <>
          <div class="post-groups" data-groups>
            {groups.map((g) => (
              <section aria-labelledby={`y${g.year}`} data-group>
                <h2 class="post-year" id={`y${g.year}`}>{g.year}</h2>
                <ul class="post-list" role="list">
                  {g.posts.map((p) => (
                    <li class="post-item" data-post data-cat={p.data.category?.id ?? ''} data-tags={p.data.tags.join(' ')} data-text={`${p.data.title} ${p.data.description} ${p.data.tags.join(' ')}`.toLowerCase()}>
                      <div class="post-meta">
                        <time datetime={p.data.pubDate.toISOString()}>{isoDate(p.data.pubDate)}</time>
                        {p === posts[0] && <span class="head">(HEAD)</span>}
                        {p.data.draft && <span class="head">(draft)</span>}
                      </div>
                      <div class="post-main">
                        <h3><a href={postUrl(p)}>{p.data.title}</a></h3>
                        <p>{p.data.description}</p>
                        <div class="post-tags">
                          {catOf(p.data.category?.id) && (
                            <a class="tag" href={categoryUrl(p.data.category!.id)} style={`--accent: ${catOf(p.data.category?.id)!.data.color}`}>
                              <span class="dot" />{catOf(p.data.category?.id)!.data.name}
                            </a>
                          )}
                          {p.data.tags.map((t) => <span class="tag">{t}</span>)}
                          <span class="mins">{readingMinutes(p.body ?? '')} min read</span>
                        </div>
                      </div>
                      <a class="post-cat" href={postUrl(p)} tabindex="-1" aria-hidden="true">cat →</a>
                    </li>
                  ))}
                </ul>
              </section>
            ))}
          </div>
          <div class="empty" data-no-results hidden>
            <p><span class="muted">grep:</span> no posts match <span class="c-amber" data-echo></span></p>
            <button type="button" data-clear>clear filters</button>
          </div>
        </>
      )
    }
  </main>
</Base>

<script>
  // Progressive enhancement: the full list is server-rendered; this only hides rows.
  const filters = document.querySelector<HTMLElement>('[data-filters]');
  if (filters) {
    filters.hidden = false;
    const input = filters.querySelector<HTMLInputElement>('[data-query]')!;
    const tagButtons = [...filters.querySelectorAll<HTMLButtonElement>('[data-tag]')];
    const catButtons = [...filters.querySelectorAll<HTMLButtonElement>('[data-cat]')];
    const items = [...document.querySelectorAll<HTMLElement>('[data-post]')];
    const groups = [...document.querySelectorAll<HTMLElement>('[data-group]')];
    const total = document.querySelector<HTMLElement>('[data-total]')!;
    const noResults = document.querySelector<HTMLElement>('[data-no-results]')!;
    const groupsWrap = document.querySelector<HTMLElement>('[data-groups]')!;
    const echo = document.querySelector<HTMLElement>('[data-echo]')!;
    let tag = 'all';
    let cat = 'all';

    const params = new URLSearchParams(location.search);
    if (params.get('q')) input.value = params.get('q')!;
    if (params.get('cat') && catButtons.some((b) => b.dataset.cat === params.get('cat'))) cat = params.get('cat')!;
    if (params.get('tag') && tagButtons.some((b) => b.dataset.tag === params.get('tag'))) tag = params.get('tag')!;

    function apply() {
      const q = input.value.trim().toLowerCase();
      let shown = 0;
      for (const item of items) {
        const ok = (tag === 'all' || item.dataset.tags!.split(' ').includes(tag)) && (cat === 'all' || item.dataset.cat === cat) && (!q || item.dataset.text!.includes(q));
        item.hidden = !ok;
        if (ok) shown++;
      }
      for (const g of groups) g.hidden = !g.querySelector('[data-post]:not([hidden])');
      tagButtons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.tag === tag)));
      catButtons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.cat === cat)));
      total.textContent = `total ${shown}`;
      groupsWrap.hidden = shown === 0;
      noResults.hidden = shown !== 0;
      echo.textContent = q ? `"${q}"` : tag !== 'all' ? `--tag ${tag}` : cat !== 'all' ? `--category ${cat}` : '';

      const url = new URL(location.href);
      q ? url.searchParams.set('q', q) : url.searchParams.delete('q');
      tag !== 'all' ? url.searchParams.set('tag', tag) : url.searchParams.delete('tag');
      cat !== 'all' ? url.searchParams.set('cat', cat) : url.searchParams.delete('cat');
      history.replaceState(null, '', url);
    }

    input.addEventListener('input', apply);
    tagButtons.forEach((b) =>
      b.addEventListener('click', () => {
        tag = b.dataset.tag!;
        apply();
      }),
    );
    catButtons.forEach((b) =>
      b.addEventListener('click', () => {
        cat = b.dataset.cat!;
        apply();
      }),
    );
    document.querySelector('[data-clear]')?.addEventListener('click', () => {
      input.value = '';
      tag = 'all';
      cat = 'all';
      apply();
      input.focus();
    });
    apply();
  }
</script>
