---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import LabLayout from '../../../components/LabLayout.astro';
import LabDocTree from '../../../components/LabDocTree.astro';
import { docUrl, type LabDoc } from '../../../lib/lab';

export const getStaticPaths = (async () => (await getCollection('labDocs')).map((doc) => ({ params: { path: doc.id }, props: { doc } }))) satisfies GetStaticPaths;

const { doc } = Astro.props as { doc: LabDoc };
const { Content } = await render(doc);

const current = docUrl(doc);
---

<LabLayout title={doc.data.title} description={doc.data.title} cwd={`~/lab/docs/${doc.id}`}>
  <div class="lab-split">
    <nav aria-label="Docs tree">
      <p class="muted mono">$ tree docs/</p>
      <LabDocTree current={current} />
    </nav>
    <article>
      <p class="muted mono">docs/{doc.id}.md</p>
      <h1>{doc.data.title}</h1>
      <div class="prose"><Content /></div>
    </article>
  </div>
</LabLayout>
