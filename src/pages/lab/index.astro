---
import { getCollection } from 'astro:content';
import LabLayout from '../../components/LabLayout.astro';
import LabNoteList from '../../components/LabNoteList.astro';
import { categoryUrl, getCategories, getNotes } from '../../lib/lab';

const categories = await getCategories();
const notes = await getNotes();
const docs = await getCollection('labDocs');
const glossary = await getCollection('labGlossary');
const count = (id: string) => notes.filter((n) => n.data.category.id === id).length;
---

<LabLayout title="Index" description="Sveltia CMS playground: categories, relations, nested folders, i18n and every field type." cwd="~/lab">
  <header>
    <h1>~/lab</h1>
    <p class="lede">Throwaway collections to see what Sveltia CMS can do. Edit them at <a href="/admin/index.html">/admin</a>; every save rebuilds this page.</p>
  </header>

  <section aria-labelledby="cats"><h2 id="cats">$ ls categories/ <span class="muted">(Categories collection, drag-and-drop order)</span></h2></section>
  <div class="lab-cards">
    {
      categories.map((c) => (
        <a class="lab-card" href={categoryUrl(c.id)} style={`--accent: ${c.data.color}`}>
          <strong>{c.data.name}</strong>
          <span>{c.data.description}</span>
          <span>{count(c.id)} notes</span>
        </a>
      ))
    }
  </div>

  <section aria-labelledby="notes"><h2 id="notes">$ ls -l notes/ <span class="muted">(Notes + the filtered Links view, same folder)</span></h2></section>
  <LabNoteList notes={notes} categories={categories} />

  <section aria-labelledby="more"><h2 id="more">$ ls</h2></section>
  <div class="lab-cards">
    <a class="lab-card" href="/lab/docs/getting-started/"><strong>docs/</strong><span>Nested collection, {docs.length} pages in a folder tree.</span></a>
    <a class="lab-card" href="/lab/glossary/"><strong>glossary</strong><span>i18n: {glossary.length} terms in English and Turkish.</span></a>
    <a class="lab-card" href="/lab/widgets/"><strong>widgets</strong><span>A singleton using every field type.</span></a>
  </div>
</LabLayout>
