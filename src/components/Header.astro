---
import { getEntry } from 'astro:content';
import Icon from './Icon.astro';
import { socialIcon } from '../lib/social';
import { CV_FILENAME } from '../site.config.mjs';

interface Props {
  section: 'home' | 'blog' | 'none';
}

const { section } = Astro.props;
const profile = (await getEntry('profile', 'profile'))!.data;
---

<header class="site-header">
  <div class="wrap header-row">
    <a class="brand" href="/" {...(section === 'home' ? { 'aria-current': 'page', 'aria-label': `${profile.name}, back to top` } : {})}>
      <span class="brand-prompt" aria-hidden="true">~ ❯</span>
      <span class="brand-name">{profile.name}</span>
    </a>
    <nav class="site-nav" aria-label="Main">
      <a class="nav-link" href="/blog/" {...(section === 'blog' ? { 'aria-current': 'page' } : {})}>Blog</a>
      {
        profile.social.map((s) => {
          const icon = socialIcon(s.key);
          return (
            icon && (
              <a class="icon-link" href={s.url} rel="me noopener" aria-label={s.label} title={s.label}>
                <Icon name={icon} />
              </a>
            )
          );
        })
      }
      <a class="icon-link" href="/rss.xml" aria-label="RSS feed" title="RSS feed"><Icon name="si-rss" /></a>
      {profile.resume && <a class="btn btn-sm nav-cv" href={profile.resume} download={CV_FILENAME}>Download CV</a>}
    </nav>
  </div>
</header>

<script>
  import { scrollToTop } from '../lib/scroll-top';

  // On the home page the name scrolls back up instead of reloading.
  document.querySelector('.site-header .brand')!.addEventListener('click', (e) => {
    if (location.pathname !== '/') return;
    e.preventDefault();
    if (location.hash) history.replaceState(null, '', '/');
    scrollToTop();
  });
</script>
