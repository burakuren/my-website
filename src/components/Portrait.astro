---
import { portraitDark, portraitLight } from '../lib/portraits';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
// Two density variants so the portrait reads well on either background.
// CSS shows one; display:none keeps the other out of the accessibility tree.
---

<pre class:list={['portrait', 'portrait-dark', className]} role="img" aria-label="ASCII portrait of Burak Üren">{portraitDark}</pre>
<pre class:list={['portrait', 'portrait-light', className]} role="img" aria-label="ASCII portrait of Burak Üren">{portraitLight}</pre>
