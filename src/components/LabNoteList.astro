---
import { isoDate } from '../lib/format';
import { noteUrl, stars, type LabCategory, type LabNote } from '../lib/lab';

interface Props {
  notes: LabNote[];
  categories: LabCategory[];
}
const { notes, categories } = Astro.props;
const byId = new Map(categories.map((c) => [c.id, c]));
---

<div class="ls">
  <div class="ls-total" aria-hidden="true">total {notes.length}</div>
  <ul class="ls-list" role="list">
    {
      notes.map((n) => {
        const cat = byId.get(n.data.category.id);
        return (
          <li class="ls-row" style={cat && `--accent: ${cat.data.color}`}>
            <time class="muted" datetime={n.data.date.toISOString()}>{isoDate(n.data.date)}</time>
            <span class="c-amber">{n.data.pinned ? '📌 ' : ''}{n.data.kind}</span>
            <div>
              <a class="ls-name" href={noteUrl(n)}>{n.data.title}</a>
              {n.data.url && <p class="ls-desc muted">{new URL(n.data.url).host}</p>}
            </div>
            <span>
              <span class="dot" />
              {cat?.data.name ?? n.data.category.id} <span class="c-amber">{stars(n.data.rating)}</span>
            </span>
          </li>
        );
      })
    }
  </ul>
</div>
