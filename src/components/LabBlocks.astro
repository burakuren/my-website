---
import { getEntry } from 'astro:content';
import { markdownToHtml } from 'satteri';

// Blocks from the "list with types" field of the lab widgets singleton.
const { blocks } = (await getEntry('labWidgets', 'widgets'))!.data;
const md = (text: string) => markdownToHtml(text).html;
---

<div class="prose">
  {
    blocks.map((b) => {
      switch (b.type) {
        case 'heading':
          return <h3>{b.text}</h3>;
        case 'paragraph':
          return <Fragment set:html={md(b.text)} />;
        case 'callout':
          return <p class="lab-callout" data-kind={b.kind}><strong>{b.kind}:</strong> {b.text}</p>;
        case 'link':
          return <p><a href={b.url} rel="noopener">{b.label} →</a></p>;
      }
    })
  }
</div>
