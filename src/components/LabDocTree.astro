---
import { getCollection } from 'astro:content';
import { docUrl, type LabDoc } from '../lib/lab';

interface Props {
  /** URL of the page being viewed, highlighted in the tree. */
  current?: string;
}
const { current } = Astro.props;

// Build a folder tree from the entry ids ("infra/dns/mail-records").
type Node = { dirs: Map<string, Node>; docs: LabDoc[] };
const root: Node = { dirs: new Map(), docs: [] };
for (const d of await getCollection('labDocs')) {
  let node = root;
  for (const p of d.id.split('/').slice(0, -1)) {
    if (!node.dirs.has(p)) node.dirs.set(p, { dirs: new Map(), docs: [] });
    node = node.dirs.get(p)!;
  }
  node.docs.push(d);
}
const sortDocs = (docs: LabDoc[]) => docs.sort((a, b) => a.data.weight - b.data.weight || a.data.title.localeCompare(b.data.title));
---

{
  (function renderNode(node: Node): any {
    return (
      <ul class="lab-tree">
        {sortDocs(node.docs).map((d) => (
          <li>
            <a href={docUrl(d)} {...(docUrl(d) === current ? { 'aria-current': 'page' } : {})}>{d.id.split('/').at(-1)}.md</a>
            <span class="muted"> {d.data.title}</span>
          </li>
        ))}
        {[...node.dirs].map(([name, child]) => (
          <li>
            <span class="c-blue">{name}/</span>
            {renderNode(child)}
          </li>
        ))}
      </ul>
    );
  })(root)
}
