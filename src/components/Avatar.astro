---
import { Picture } from 'astro:assets';
import photo from '../assets/burak.jpg';

interface Props {
  /** Rendered size in CSS pixels (the image is square). */
  size: number;
  alt: string;
  eager?: boolean;
  /** For an image whose size changes with the viewport: candidate widths plus
   *  a `sizes` attribute, instead of 1x/2x of `size`. */
  widths?: number[];
  sizes?: string;
  class?: string;
}

const { size, alt, eager = false, widths, sizes, class: className } = Astro.props;
// AVIF first, then WebP, with the original JPEG as the fallback <img>.
const resolution = widths && sizes ? { widths, sizes } : { densities: [1, 2] };
---

<Picture
  src={photo}
  alt={alt}
  width={size}
  height={size}
  {...resolution}
  formats={['avif', 'webp']}
  fallbackFormat="jpg"
  quality={80}
  class="avatar"
  pictureAttributes={className ? { class: className } : {}}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : 'auto'}
/>
