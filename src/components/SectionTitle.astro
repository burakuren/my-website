---
/**
 * A home-page section's h2 with a link icon at the right end of the row, so
 * any section can be shared (`/#experience`). The link sits beside the h2,
 * not inside it, to keep the heading's accessible name clean.
 * `src/lib/section-links.ts` copies the URL on click.
 */
import Icon from './Icon.astro';

interface Props {
  /** The section's id; the h2 gets `${id}-title` for aria-labelledby. */
  id: string;
  title: string;
}

const { id, title } = Astro.props;
---

<h2 id={`${id}-title`}>{title}</h2>
<span class="section-link">
  <a class="section-anchor" href={`#${id}`} aria-label={`Link to ${title}`}><Icon name="i-link" /></a>
  <span class="anchor-status" role="status" aria-live="polite"></span>
</span>
