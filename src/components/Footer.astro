---
import { SOURCE_URL } from '../site.config.mjs';

interface Props {
  name: string;
}
const { name } = Astro.props;
---

<footer class="site-footer">
  <div class="wrap footer-row">
    <p>© {new Date().getFullYear()} {name}</p>
    <p>Built with Astro, served from Cloudflare. <a href={SOURCE_URL} rel="noopener">Source on GitHub</a></p>
  </div>
</footer>
