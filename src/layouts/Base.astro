---
import { Font } from 'astro:assets';
import { getEntry } from 'astro:content';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BackToTop from '../components/BackToTop.astro';
import { SITE_NAME } from '../site.config.mjs';
import { THEME_INIT } from '../lib/theme-init.mjs';

interface Props {
  title: string;
  description: string;
  /** Which nav item is the current page. */
  section?: 'home' | 'blog' | 'none';
  /** Path shown in the header prompt, e.g. "~/blog". */
  cwd?: string;
  /** Right-hand label in the footer, e.g. "UREN(1)". */
  manPage?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: 'website' | 'article' | 'profile';
  article?: { published: Date; modified?: Date; tags: string[] };
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
}

const {
  title,
  description,
  section = 'none',
  cwd = '~',
  manPage = 'UREN(1)',
  ogImage = '/og.png',
  ogImageAlt = `${SITE_NAME}: backend software engineer`,
  ogType = 'website',
  article,
  noindex = false,
  jsonLd = [],
} = Astro.props;

const profile = (await getEntry('profile', 'profile'))!.data;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);
const social = Object.fromEntries(profile.social.map((s) => [s.key, s.url]));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline set:html={THEME_INIT} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="author" content={profile.name} />
    <meta name="generator" content={Astro.generator} />

    <meta name="theme-color" content="#15171c" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE_NAME} | Blog`} href={new URL('/rss.xml', Astro.site)} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {social.github && <link rel="me" href={social.github} />}
    {social.linkedin && <link rel="me" href={social.linkedin} />}

    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {ogType === 'profile' && <meta property="profile:first_name" content={profile.name.split(' ')[0]} />}
    {ogType === 'profile' && <meta property="profile:last_name" content={profile.name.split(' ').slice(1).join(' ')} />}
    {ogType === 'profile' && <meta property="profile:username" content={profile.handle} />}
    {article && <meta property="article:published_time" content={article.published.toISOString()} />}
    {article?.modified && <meta property="article:modified_time" content={article.modified.toISOString()} />}
    {article && <meta property="article:author" content={new URL('/', Astro.site)} />}
    {article?.tags.map((t) => <meta property="article:tag" content={t} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <Font cssVariable="--font-sans" preload={[{ weight: 400, style: 'normal', subset: 'latin' }]} />
    <Font cssVariable="--font-mono" preload={[{ weight: 700, style: 'normal', subset: 'latin' }, { weight: 400, style: 'normal', subset: 'latin' }]} />

    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data).replace(/</g, '\\u003c')} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header section={section} cwd={cwd} />
    <slot />
    <Footer name={profile.name} manPage={manPage} />
    <BackToTop />
  </body>
</html>
